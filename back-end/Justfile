set shell := ["zsh", "-cu"]
python_version := "3.12"

# =========================
# Discover
# =========================
default:
  @just --list

# =========================
# Environment Setup
# =========================
# Create virtual environment with supported Python
venv:
  uv venv --python {{python_version}}

# Install supported Python and create venv
bootstrap:
  uv python install {{python_version}}
  uv venv --python {{python_version}}
  uv sync --all-groups

# Print activate command (macOS/Linux)
activate:
  @echo "source .venv/bin/activate"

# Install project dependencies from pyproject/lock
sync:
  uv sync --all-groups

# =========================
# Run & Test
# =========================
# Run FastAPI app with reload
run:
  uv run uvicorn main:app --reload

# Run test suite
test:
  uv run pytest

# =========================
# pip -> uv Replacements
# =========================
# pip install <package>  -> just pip-install package=<package>
pip-install package:
  uv add {{package}}

# pip install -r requirements.txt -> just pip-install-r file=requirements.txt
pip-install-r file="requirements_dev.txt":
  uv add -r {{file}}

# pip uninstall <package> -> just pip-uninstall package=<package>
pip-uninstall package:
  uv remove {{package}}

# pip freeze -> just pip-freeze
pip-freeze:
  uv pip freeze

# pip list -> just pip-list
pip-list:
  uv pip list

# pip show <package> -> just pip-show package=<package>
pip-show package:
  uv pip show {{package}}

# pip install --upgrade <package> -> just pip-upgrade package=<package>
pip-upgrade package:
  uv add --upgrade-package {{package}}

# Dev dependency helpers
add-dev package:
  uv add --dev {{package}}

add package:
  uv add {{package}}
