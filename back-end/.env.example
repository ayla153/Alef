# Copy to .env and fill in values before: just setup && just start

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Online Postgres (e.g. Neon) — use direct or pooler host from your provider
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_SSLMODE=require

# Comma-separated frontend origins (no spaces)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_SEND_COOLDOWN_SECONDS=60
OTP_VERIFY_LOCKOUT_MINUTES=15

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Log OTP codes to server console instead of sending email (local dev)
EMAIL_DEV_LOG_OTP=true

PENDING_REGISTRATION_EXPIRE_HOURS=1
