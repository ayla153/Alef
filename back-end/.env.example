# Copy to .env and fill in values before: just setup && just start

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Online Postgres (e.g. Neon) — use direct or pooler host from your provider
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_SSLMODE=require

# Comma-separated frontend origins (no spaces)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# OTP verification (registration & password reset)
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=5

# Email / SMTP (optional in dev if EMAIL_DEV_LOG_OTP=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Log OTP codes to server logs instead of sending email (local dev only)
EMAIL_DEV_LOG_OTP=false
